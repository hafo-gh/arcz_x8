# Copy to .env (repo root) and adjust for this vehicle. `docker compose`
# loads .env from the directory it's run in automatically, so as long as
# containers are brought up from the repo root (as scripts/install.sh
# does), every package below picks these values up -- no per-package .env
# files and no editing of launch/*.py or config/*.yaml needed.
#
# Never commit the real .env (it's already in .gitignore).

# ROS2 distro used to build the shared base image and inside every container.
ROS_DISTRO=jazzy

# ROS2 graph domain ID; must match across all containers on this vehicle.
ROS_DOMAIN_ID=0

# Flight-controller serial link (arcz_connection). Prefer a /dev/serial/by-id/...
# path over /dev/ttyACM0 -- the latter can renumber on a flight-controller
# reboot/USB reconnect, the former doesn't.
PX4_SERIAL_DEVICE=/dev/ttyACM0
PX4_SERIAL_BAUD=921600

# This vehicle's UUID in the mrblack database (arcz_postflight).
VEHICLE_ID=

# mrblack server address (host:port), used for both the upload endpoint and
# the online-connectivity probe (arcz_postflight).
MRBLACK_HOST=mrblack:8000

# Bearer token for uploading flight data to mrblack (arcz_postflight).
# Get the real value from mrblack.
MALP_UPLOAD_TOKEN=
