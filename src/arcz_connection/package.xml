<?xml version="1.0"?>
<package format="3">
  <name>arcz_connection</name>
  <version>0.0.1</version>
  <description>Connectivity: mavlink split/bridge, zenoh router, foxglove bridge, internet connection</description>
  <maintainer email="radek.domin@gmail.com">Radek</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-pymavlink</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rmw_zenoh_cpp</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
